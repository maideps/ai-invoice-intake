# Copy to backend/.env for local development. All variables are optional.
INVOICE_INTAKE_APP_NAME="AI Invoice Intake"
INVOICE_INTAKE_ENVIRONMENT=development   # development | test | production
INVOICE_INTAKE_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# PostgreSQL. Port 5433 so it does not clash with a local PostgreSQL on 5432 (see README).
INVOICE_INTAKE_DATABASE_URL=postgresql+psycopg://invoice_intake:invoice_intake@localhost:5433/invoice_intake
INVOICE_INTAKE_MAX_UPLOAD_BYTES=10485760  # 10 MB
# AI extraction (D-005). "fake" needs no key or network and recognises the synthetic samples.
INVOICE_INTAKE_EXTRACTION_PROVIDER=fake   # fake | openai
# INVOICE_INTAKE_FAKE_SAMPLES_DIR=../samples/invoices   # default: the repository's samples
# Only for the openai provider. Never commit a real key.
# INVOICE_INTAKE_OPENAI_API_KEY=sk-...
# INVOICE_INTAKE_OPENAI_MODEL=gpt-5.4-mini
# INVOICE_INTAKE_OPENAI_TIMEOUT_SECONDS=60
# Background extraction (D-010): the API queues uploads in Redis, the worker extracts them.
INVOICE_INTAKE_REDIS_URL=redis://localhost:6379/0
INVOICE_INTAKE_EXTRACTION_MAX_ATTEMPTS=3
INVOICE_INTAKE_EXTRACTION_RETRY_BASE_SECONDS=5   # waits 5 s, then 10 s, ... between attempts
# INVOICE_INTAKE_WORKER_ID=worker          # give each worker process its own id
# INVOICE_INTAKE_WORKER_SWEEP_SECONDS=60   # how often stuck uploads are re-queued
