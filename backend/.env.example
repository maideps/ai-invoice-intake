# Copy to backend/.env for local development. All variables are optional.
INVOICE_INTAKE_APP_NAME="AI Invoice Intake"
INVOICE_INTAKE_ENVIRONMENT=development   # development | test | production
INVOICE_INTAKE_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# PostgreSQL. Port 5433 so it does not clash with a local PostgreSQL on 5432 (see README).
INVOICE_INTAKE_DATABASE_URL=postgresql+psycopg://invoice_intake:invoice_intake@localhost:5433/invoice_intake
INVOICE_INTAKE_MAX_UPLOAD_BYTES=10485760  # 10 MB
